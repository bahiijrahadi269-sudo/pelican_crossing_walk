// ============================================================================
// PROGRAM PELICAN CROSSING (LAMPU PENYEBERANGAN PEJALAN KAKI)
// SIEMENS S7-1200 - TIA PORTAL V16 / V17 / V18 / V19 / V20 / V21
// Versi 0.7 (Safety Interlock & Autonomous Fail-Safe Edition):
//  [SAFETY 1] INTERLOCK TRANSISI MANUAL (ANTI-TABRAKAN):
//             Lompat manual ke State 4 (Crossing) saat kendaraan HIJAU (State 0/1/6)
//             otomatis dialihkan via State 2 (Kuning) -> State 3 (All Red) -> State 4.
//             Mencegah lampu kendaraan merah mendadak tanpa rambu kuning!
//  [SAFETY 2] INTERLOCK CLEARANCE PEJALAN KAKI:
//             Lompat manual ke State 0 (Kendaraan Hijau) saat pejalan kaki MENYEBERANG (State 4)
//             otomatis dialihkan via State 5 (All Red Clearance) agar pejalan kaki selesai menepi!
//  [SAFETY 3] AUTONOMOUS WATCHDOG FAIL-SAFE:
//             Jika koneksi Modbus dengan Jetson putus selama >= 60 detik (Jetson mati/kabel putus),
//             PLC otomatis me-reset State PAUSE (Reg 11 := 1) dan Parade Lock (Reg 10 := 0)
//             sehingga lampu kembali beroperasi otonom di lapangan untuk keselamatan publik!
//  [FIX 1-6 ] Tetap mempertahankan perbaikan dari v0.6 (Pause di S0, kedip 0.5s, buzzer mute saat pause,
//             watchdog disconnect soket 10s, Reg 20 bitmask, Reg 21 countdown, Reg 22 heartbeat).
//
// PETA REGISTER MODBUS (DB_Jetson_Comm.Holding_Data) -> WAJIB Array[0..29] of Int
//  Reg 0      : State aktif (0..6)                         PLC  -> Jetson
//  Reg 1      : Total akumulasi pelanggaran                 PLC  -> Jetson
//  Reg 2..7   : Durasi State 1..6 (detik)                   Jetson -> PLC
//  Reg 8      : Buzzer State 4 Crossing (0=Mute/OFF, 1=ON)  Jetson -> PLC
//  Reg 9      : Mode standby (0=Hijau, 1=Flash Kuning)      Jetson -> PLC
//  Reg 10     : Parade Lock (1=Kunci State 0)               Jetson -> PLC
//  Reg 11     : State Run (1=Jalan, 0=Pause)                Jetson -> PLC
//  Reg 12     : Lompat state manual (0..6, -1=idle, auto-clear oleh PLC)  Jetson -> PLC
//  Reg 13     : Lampu sorot (0=Auto, 1=ON, 2=OFF)           Jetson -> PLC
//  Reg 14, 15 : Pelanggaran Sisi 1 / Sisi 2                 PLC  -> Jetson
//  Reg 16..19 : Jadwal lampu sorot (JamOn, MntOn, JamOff, MntOff)  Jetson -> PLC
//  Reg 20     : Bitmask output (bit0=Q0.0 ... bit7=Q0.7)    PLC  -> Jetson
//  Reg 21     : Detik berjalan pada state aktif             PLC  -> Jetson
//  Reg 22     : Heartbeat PLC                               PLC  -> Jetson
//  Reg 23     : Reset akumulasi pelanggaran (1=reset, auto-clear oleh PLC)  Jetson -> PLC
//  Reg 24..29 : Cadangan
// ============================================================================

// ----------------------------------------------------------------------------
// 1. FUNCTION BLOCK: LOGIKA UTAMA PELICAN CROSSING
// ----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_PelicanCrossing"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.7

VAR_INPUT
    btn_Pedestrian_1     : Bool; // Tombol Pejalan Kaki Sisi 1 / Barat (%I0.0)
    btn_Pedestrian_2     : Bool; // Tombol Pejalan Kaki Sisi 2 / Timur (%I0.1)
    Clock_1Hz            : Bool; // Pulsa Detik dari System Memory PLC (%M0.5)

    // Parameter Konfigurasi & Kontrol dari Jetson (via Modbus Holding Registers):
    cfg_BuzzerCross      : Bool; // Reg 8: Kontrol Buzzer saat State 4 (Crossing) (1=ON, 0=MUTE)
    cfg_DefaultMode      : Int;  // Reg 9: 0=Hijau, 1=Flash Kuning
    cfg_ParadeLock       : Bool; // Reg 10: Kunci Pawai / Acara (Force State 0)
    cfg_StateRun         : Bool; // Reg 11: 1=Run, 0=Pause
    cfg_ManualState      : Int;  // Reg 12: Lompat State Manual
    cfg_FloodlightMode   : Int;  // Reg 13: 0=Auto, 1=Force ON, 2=Force OFF
    cfg_FloodlightOnHour : Int;  // Reg 16
    cfg_FloodlightOnMin  : Int;  // Reg 17
    cfg_FloodlightOffHour: Int;  // Reg 18
    cfg_FloodlightOffMin : Int;  // Reg 19
    cfg_ResetViolation   : Bool; // Reg 23: Reset akumulasi pelanggaran (1=reset, auto-clear oleh PLC)

    // Konfigurasi Timer State 1 s/d 6 (Detik)
    cfg_TimerState1      : Int;  // Reg 2
    cfg_TimerState2      : Int;  // Reg 3
    cfg_TimerState3      : Int;  // Reg 4
    cfg_TimerState4      : Int;  // Reg 5
    cfg_TimerState5      : Int;  // Reg 6
    cfg_TimerState6      : Int;  // Reg 7
END_VAR

VAR_OUTPUT
    out_Traffic_Green  : Bool; // Lampu Hijau Kendaraan (%Q0.0)
    out_Traffic_Yellow : Bool; // Lampu Kuning Kendaraan (%Q0.1)
    out_Traffic_Red    : Bool; // Lampu Merah Kendaraan (%Q0.2)
    out_Ped_Green      : Bool; // Lampu Hijau Pejalan Kaki (%Q0.3)
    out_Ped_Red        : Bool; // Lampu Merah Pejalan Kaki (%Q0.4)
    // %Q0.5 : SPARE - Display "TUNGGU" tidak lagi dikontrol dari PLC (dikontrol di luar PLC)
    out_Buzzer         : Bool; // Buzzer Suara Pejalan Kaki (%Q0.6)
    out_Floodlight     : Bool; // Lampu Sorot Zebra Cross (%Q0.7)
    out_Violation_Side1: Int;  // Akumulasi Pelanggaran Tombol Sisi 1
    out_Violation_Side2: Int;  // Akumulasi Pelanggaran Tombol Sisi 2
    out_TimerVal       : Int;  // Detik berjalan pada state aktif
    out_Heartbeat      : Int;  // Penghitung detik hidup PLC
END_VAR

VAR
    iState              : Int := 0;      // State Machine Aktif (0 - 6)
    iTimerVal           : Int := 0;      // Penghitung Waktu Detik
    bButtonLatched      : Bool := FALSE; // Status Tombol Ditekan & Pengunci
    iButtonCounter_1    : Int := 0;      // Penghitung Tekanan Ekstra Tombol Sisi 1
    iButtonCounter_2    : Int := 0;      // Penghitung Tekanan Ekstra Tombol Sisi 2
    iViolation          : Int := 0;      // Total Akumulasi Pelanggaran
    iViolation_1        : Int := 0;      // Pelanggaran Sisi 1
    iViolation_2        : Int := 0;      // Pelanggaran Sisi 2
    bBtnMem_1           : Bool := FALSE; // Memori Edge Tombol 1
    bBtnMem_2           : Bool := FALSE; // Memori Edge Tombol 2
    bSecMem             : Bool := FALSE; // Memori Edge Detik (1 Hz)
    iLastManualStateCmd : Int := -1;     // Memori pendeteksi perubahan manual state
    iHeartbeat          : Int := 0;      // Penghitung heartbeat

    // [SAFETY INTERLOCK VARIABLES]
    bInterlockActive    : Bool := FALSE; // TRUE jika proses transisi interlock sedang berjalan
    iPendingTargetState : Int := -1;     // Target state akhir yang diminta operator

    dtLocalTime         : DTL;           // Waktu Real-Time PLC
    iRetTime            : Int;           // Return Code RD_LOC_T
    bFloodlightAuto     : Bool := FALSE; // Status Otomatis Lampu Sorot

    iTimerState1        : Int := 10;
    iTimerState2        : Int := 3;
    iTimerState3        : Int := 3;
    iTimerState4        : Int := 20;
    iTimerState5        : Int := 3;
    iTimerState6        : Int := 60;
END_VAR

VAR_TEMP
    bBtnPulse_1 : Bool;
    bBtnPulse_2 : Bool;
    bBtnPulse   : Bool;
    bSecPulse   : Bool;
    iFlOnH      : Int;
    iFlOnM      : Int;
    iFlOffH     : Int;
    iFlOffM     : Int;
    iCurMin     : Int;
    iOnMin      : Int;
    iOffMin     : Int;
END_VAR

BEGIN
    // Update nilai timer dinamis dari Jetson jika valid (> 0)
    IF #cfg_TimerState1 > 0 THEN #iTimerState1 := #cfg_TimerState1; END_IF;
    IF #cfg_TimerState2 > 0 THEN #iTimerState2 := #cfg_TimerState2; END_IF;
    IF #cfg_TimerState3 > 0 THEN #iTimerState3 := #cfg_TimerState3; END_IF;
    IF #cfg_TimerState4 > 0 THEN #iTimerState4 := #cfg_TimerState4; END_IF;
    IF #cfg_TimerState5 > 0 THEN #iTimerState5 := #cfg_TimerState5; END_IF;
    IF #cfg_TimerState6 > 0 THEN #iTimerState6 := #cfg_TimerState6; END_IF;

    // Pulsa 1 detik (dipakai timer state & heartbeat)
    #bSecPulse := #Clock_1Hz AND (NOT #bSecMem);
    #bSecMem   := #Clock_1Hz;

    IF #bSecPulse THEN
        IF #iHeartbeat >= 32000 THEN
            #iHeartbeat := 0;
        ELSE
            #iHeartbeat := #iHeartbeat + 1;
        END_IF;
    END_IF;

    // =========================================================================
    // 0. KONTROL MANUAL DENGAN SAFETY INTERLOCK (ANTI-TABRAKAN & ANTI-BAHAYA)
    // =========================================================================
    IF (#cfg_ManualState >= 0) AND (#cfg_ManualState <= 6) AND (#cfg_ManualState <> #iLastManualStateCmd) THEN
        #iLastManualStateCmd := #cfg_ManualState;

        // [SAFETY INTERLOCK 1]: Permintaan ke State Menyeberang (State 3 / State 4) saat kendaraan sedang HIJAU (State 0, 1, 6)
        // BAHAYA jika langsung lompat! Kendaraan butuh waktu pengereman.
        // Interlock: Alihkan otomatis ke State 2 (Kuning) terlebih dahulu.
        IF (#cfg_ManualState = 3 OR #cfg_ManualState = 4) AND (#iState = 0 OR #iState = 1 OR #iState = 6) THEN
            #bInterlockActive   := TRUE;
            #iPendingTargetState:= #cfg_ManualState;
            #iState             := 2;   // Mulai dari Lampu Kuning Kendaraan (State 2)
            #iTimerVal          := 0;
            #bButtonLatched     := TRUE;

        // [SAFETY INTERLOCK 2]: Permintaan ke Kendaraan HIJAU (State 0, 1, 6) saat pejalan kaki sedang MENYEBERANG (State 4)
        // BAHAYA PEJALAN KAKI! Pejalan kaki sedang di zebra cross.
        // Interlock: Alihkan otomatis ke State 5 (All Red Clearance) agar pejalan kaki selesai menepi dengan aman.
        ELSIF (#cfg_ManualState = 0 OR #cfg_ManualState = 1 OR #cfg_ManualState = 6) AND (#iState = 4) THEN
            #bInterlockActive   := TRUE;
            #iPendingTargetState:= #cfg_ManualState;
            #iState             := 5;   // Beri clearance All Red (State 5) sebelum kendaraan hijau
            #iTimerVal          := 0;

        // [KASUS STANDAR]: Perpindahan aman lainnya (misal: lompat ke State 2 dari 0, atau lompat saat sudah all-red)
        ELSE
            #bInterlockActive   := FALSE;
            #iPendingTargetState:= -1;
            #iState             := #cfg_ManualState;
            #iTimerVal          := 0;
            IF #cfg_ManualState = 0 THEN
                #bButtonLatched   := FALSE;
                #iButtonCounter_1 := 0;
                #iButtonCounter_2 := 0;
            END_IF;
        END_IF;

    ELSIF #cfg_ManualState < 0 THEN
        #iLastManualStateCmd := -1;
    END_IF;

    // =========================================================================
    // 1. PENDETEKSI PUSH BUTTON DUA SISI (RISING EDGE INDEPENDEN)
    // =========================================================================
    #bBtnPulse_1 := #btn_Pedestrian_1 AND (NOT #bBtnMem_1);
    #bBtnMem_1   := #btn_Pedestrian_1;

    #bBtnPulse_2 := #btn_Pedestrian_2 AND (NOT #bBtnMem_2);
    #bBtnMem_2   := #btn_Pedestrian_2;

    #bBtnPulse   := #bBtnPulse_1 OR #bBtnPulse_2;

    IF #bBtnPulse THEN
        IF (#iState = 0 OR #iState = 6) AND (NOT #bButtonLatched) THEN
            #bButtonLatched := TRUE;
        ELSIF #bButtonLatched THEN
            IF #bBtnPulse_1 THEN #iButtonCounter_1 := #iButtonCounter_1 + 1; END_IF;
            IF #bBtnPulse_2 THEN #iButtonCounter_2 := #iButtonCounter_2 + 1; END_IF;
        END_IF;
    END_IF;

    // =========================================================================
    // 2. KUNCI STATE / MODE ACARA / PARADE
    // =========================================================================
    IF #cfg_ParadeLock THEN
        #iState             := 0;
        #iTimerVal          := 0;
        #bButtonLatched     := FALSE;
        #iButtonCounter_1   := 0;
        #iButtonCounter_2   := 0;
        #bInterlockActive   := FALSE;
        #iPendingTargetState:= -1;
    END_IF;

    // =========================================================================
    // 2B. RESET AKUMULASI PELANGGARAN (Perintah 'Reset Session' dari Dashboard)
    // =========================================================================
    IF #cfg_ResetViolation THEN
        #iViolation       := 0;
        #iViolation_1     := 0;
        #iViolation_2     := 0;
        #iButtonCounter_1 := 0;
        #iButtonCounter_2 := 0;
    END_IF;

    // =========================================================================
    // 3. TIMER 1 DETIK & LOGIKA PAUSE
    // =========================================================================
    IF (#iState <> 0) AND #bSecPulse AND #cfg_StateRun AND (NOT #cfg_ParadeLock) THEN
        #iTimerVal := #iTimerVal + 1;
    END_IF;

    // =========================================================================
    // 4. LOGIKA STATE MACHINE (FSM)
    // =========================================================================
    CASE #iState OF
        0: // Standby / Normal (Hijau atau Flash Kuning)
            IF #cfg_DefaultMode = 1 THEN
                #out_Traffic_Green  := FALSE;
                #out_Traffic_Yellow := #Clock_1Hz;   // Kedip 0.5s ON / 0.5s OFF
            ELSE
                #out_Traffic_Green  := TRUE;
                #out_Traffic_Yellow := FALSE;
            END_IF;
            #out_Traffic_Red    := FALSE;
            #out_Ped_Green      := FALSE;
            #out_Ped_Red        := TRUE;
            #out_Buzzer         := FALSE;

            IF #cfg_StateRun AND (NOT #cfg_ParadeLock) AND #bButtonLatched THEN
                #iTimerVal := 0;
                #iState    := 1;
            END_IF;

        1: // Persiapan kendaraan (tombol sudah ditekan)
            IF #cfg_DefaultMode = 1 THEN
                #out_Traffic_Green  := FALSE;
                #out_Traffic_Yellow := #Clock_1Hz;
            ELSE
                #out_Traffic_Green  := TRUE;
                #out_Traffic_Yellow := FALSE;
            END_IF;
            #out_Traffic_Red    := FALSE;
            #out_Ped_Green      := FALSE;
            #out_Ped_Red        := TRUE;
            #out_Buzzer         := FALSE;

            IF #cfg_StateRun AND (#iTimerVal >= #iTimerState1) THEN
                #iTimerVal := 0;
                #iState    := 2;
            END_IF;

        2: // Kuning kendaraan (Caution)
            #out_Traffic_Green  := FALSE;
            #out_Traffic_Yellow := TRUE;
            #out_Traffic_Red    := FALSE;
            #out_Ped_Green      := FALSE;
            #out_Ped_Red        := TRUE;
            #out_Buzzer         := FALSE;

            IF #cfg_StateRun AND (#iTimerVal >= #iTimerState2) THEN
                #iTimerVal := 0;
                #iState    := 3; // Lanjut ke All Red 1
            END_IF;

        3: // All Red 1 (Clearance Kendaraan)
            #out_Traffic_Green  := FALSE;
            #out_Traffic_Yellow := FALSE;
            #out_Traffic_Red    := TRUE;
            #out_Ped_Green      := FALSE;
            #out_Ped_Red        := TRUE;
            #out_Buzzer         := FALSE;

            IF #cfg_StateRun AND (#iTimerVal >= #iTimerState3) THEN
                #iTimerVal := 0;
                #iState    := 4; // Lanjut ke Crossing
                IF #bInterlockActive AND (#iPendingTargetState = 3 OR #iPendingTargetState = 4) THEN
                    #bInterlockActive    := FALSE;
                    #iPendingTargetState := -1;
                END_IF;
            END_IF;

        4: // Pejalan kaki menyeberang (Crossing)
            #out_Traffic_Green  := FALSE;
            #out_Traffic_Yellow := FALSE;
            #out_Traffic_Red    := TRUE;
            #out_Ped_Green      := TRUE;
            #out_Ped_Red        := FALSE;

            // Kontrol Suara Buzzer saat Pejalan Kaki Menyeberang (Reg 8: 1=Buzzer ON, 0=Mute)
            IF #cfg_BuzzerCross THEN
                #out_Buzzer := (#iTimerVal MOD 2 = 0);
                IF #iTimerVal >= (#iTimerState4 - 5) THEN
                    #out_Buzzer := #Clock_1Hz;
                END_IF;
            ELSE
                #out_Buzzer := FALSE;
            END_IF;

            IF #cfg_StateRun AND (#iTimerVal >= #iTimerState4) THEN
                #iTimerVal := 0;
                #iState    := 5; // Lanjut ke All Red 2
            END_IF;

        5: // All Red 2 (Clearance Pejalan Kaki & Hitung Pelanggaran)
            #out_Traffic_Green  := FALSE;
            #out_Traffic_Yellow := FALSE;
            #out_Traffic_Red    := TRUE;
            #out_Ped_Green      := FALSE;
            #out_Ped_Red        := TRUE;
            #out_Buzzer         := FALSE;

            IF #cfg_StateRun AND (#iTimerVal >= #iTimerState5) THEN
                #iViolation_1      := #iViolation_1 + #iButtonCounter_1;
                #iViolation_2      := #iViolation_2 + #iButtonCounter_2;
                #iViolation        := #iViolation + #iButtonCounter_1 + #iButtonCounter_2;
                #bButtonLatched    := FALSE;
                #iButtonCounter_1  := 0;
                #iButtonCounter_2  := 0;
                #iTimerVal         := 0;

                // Jika interlock sedang mengarahkan ke State 0 (Normal Standby):
                IF #bInterlockActive AND (#iPendingTargetState = 0) THEN
                    #bInterlockActive    := FALSE;
                    #iPendingTargetState := -1;
                    #iState              := 0; // Masuk ke State 0 dengan aman!
                ELSE
                    #bInterlockActive    := FALSE;
                    #iPendingTargetState := -1;
                    #iState              := 6; // Lanjut normal ke Cooldown
                END_IF;
            END_IF;

        6: // Cooldown (Menunggu sebelum siklus berikutnya)
            #out_Traffic_Green  := TRUE;
            #out_Traffic_Yellow := FALSE;
            #out_Traffic_Red    := FALSE;
            #out_Ped_Green      := FALSE;
            #out_Ped_Red        := TRUE;
            #out_Buzzer         := FALSE;

            IF #cfg_StateRun AND (#iTimerVal >= #iTimerState6) THEN
                #iTimerVal := 0;
                IF #bButtonLatched THEN
                    #iState := 1;
                ELSE
                    #iState := 0;
                END_IF;
            END_IF;

        ELSE
            #iState := 0;
    END_CASE;

    // Saat PAUSE, buzzer wajib diam
    IF NOT #cfg_StateRun THEN
        #out_Buzzer := FALSE;
    END_IF;

    #out_Violation_Side1 := #iViolation_1;
    #out_Violation_Side2 := #iViolation_2;
    #out_TimerVal        := #iTimerVal;
    #out_Heartbeat       := #iHeartbeat;

    // =========================================================================
    // 5. LAMPU SOROT ZEBRA CROSS (Jadwal RTC + Override dari Jetson)
    // =========================================================================
    #iRetTime := RD_LOC_T(#dtLocalTime);

    #iFlOnH  := #cfg_FloodlightOnHour;
    #iFlOnM  := #cfg_FloodlightOnMin;
    #iFlOffH := #cfg_FloodlightOffHour;
    #iFlOffM := #cfg_FloodlightOffMin;

    IF (#iFlOnH < 0) OR (#iFlOnH > 23) OR (#iFlOffH < 0) OR (#iFlOffH > 23)
       OR (#iFlOnM < 0) OR (#iFlOnM > 59) OR (#iFlOffM < 0) OR (#iFlOffM > 59)
       OR ((#iFlOnH = 0) AND (#iFlOnM = 0) AND (#iFlOffH = 0) AND (#iFlOffM = 0)) THEN
        #iFlOnH  := 17;
        #iFlOnM  := 30;
        #iFlOffH := 6;
        #iFlOffM := 0;
    END_IF;

    #iCurMin := (USINT_TO_INT(#dtLocalTime.HOUR) * 60) + USINT_TO_INT(#dtLocalTime.MINUTE);
    #iOnMin  := (#iFlOnH * 60) + #iFlOnM;
    #iOffMin := (#iFlOffH * 60) + #iFlOffM;

    IF #iOnMin > #iOffMin THEN
        #bFloodlightAuto := (#iCurMin >= #iOnMin) OR (#iCurMin < #iOffMin);
    ELSIF #iOnMin < #iOffMin THEN
        #bFloodlightAuto := (#iCurMin >= #iOnMin) AND (#iCurMin < #iOffMin);
    ELSE
        #bFloodlightAuto := TRUE;
    END_IF;

    IF #cfg_FloodlightMode = 1 THEN
        #out_Floodlight := TRUE;
    ELSIF #cfg_FloodlightMode = 2 THEN
        #out_Floodlight := FALSE;
    ELSE
        #out_Floodlight := #bFloodlightAuto;
    END_IF;

END_FUNCTION_BLOCK


// ----------------------------------------------------------------------------
// 2. INSTANCE DATA BLOCK
// ----------------------------------------------------------------------------
DATA_BLOCK "DB_PelicanCrossing"
"FB_PelicanCrossing"
BEGIN
END_DATA_BLOCK


// ----------------------------------------------------------------------------
// 3. DATA BLOCK SISTEM (Flag inisialisasi & Watchdog Modbus) - NON RETAIN
// ----------------------------------------------------------------------------
DATA_BLOCK "DB_PelicanSys"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
NON_RETAIN
   VAR
      bInitDone     : Bool := FALSE; // TRUE setelah inisialisasi awal selesai
      bSecMem       : Bool := FALSE; // Memori edge Clock 1 Hz
      iMbIdleSec    : Int := 0;      // Detik tanpa request Modbus
      bMbDisconnect : Bool := FALSE; // Perintah putus koneksi Modbus lama
      iOutMask      : Int := 0;      // Bitmask output Q0.0..Q0.7
   END_VAR

BEGIN
END_DATA_BLOCK


// ----------------------------------------------------------------------------
// 4. MAIN BLOCK (OB1)
// ----------------------------------------------------------------------------
ORGANIZATION_BLOCK "Main"
TITLE = "Main Program Block"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.7

VAR_TEMP
    bSecPulse : Bool;
END_VAR

BEGIN
    // =========================================================================
    // A. INISIALISASI SEKALI SAAT PLC START
    // =========================================================================
    IF NOT "DB_PelicanSys".bInitDone THEN
        "DB_Jetson_Comm".Holding_Data[11] := 1;    // State Run = Jalan
        "DB_Jetson_Comm".Holding_Data[12] := -1;   // Manual State = Idle
        IF ("DB_Jetson_Comm".Holding_Data[16] = 0) AND ("DB_Jetson_Comm".Holding_Data[17] = 0)
           AND ("DB_Jetson_Comm".Holding_Data[18] = 0) AND ("DB_Jetson_Comm".Holding_Data[19] = 0) THEN
            "DB_Jetson_Comm".Holding_Data[16] := 17;
            "DB_Jetson_Comm".Holding_Data[17] := 30;
            "DB_Jetson_Comm".Holding_Data[18] := 6;
            "DB_Jetson_Comm".Holding_Data[19] := 0;
        END_IF;
        "DB_PelicanSys".bInitDone := TRUE;
    END_IF;

    // Nilai default timer jika register bernilai 0 / negatif
    IF "DB_Jetson_Comm".Holding_Data[2] <= 0 THEN "DB_Jetson_Comm".Holding_Data[2] := 10; END_IF;
    IF "DB_Jetson_Comm".Holding_Data[3] <= 0 THEN "DB_Jetson_Comm".Holding_Data[3] := 3;  END_IF;
    IF "DB_Jetson_Comm".Holding_Data[4] <= 0 THEN "DB_Jetson_Comm".Holding_Data[4] := 3;  END_IF;
    IF "DB_Jetson_Comm".Holding_Data[5] <= 0 THEN "DB_Jetson_Comm".Holding_Data[5] := 20; END_IF;
    IF "DB_Jetson_Comm".Holding_Data[6] <= 0 THEN "DB_Jetson_Comm".Holding_Data[6] := 3;  END_IF;
    IF "DB_Jetson_Comm".Holding_Data[7] <= 0 THEN "DB_Jetson_Comm".Holding_Data[7] := 60; END_IF;

    // =========================================================================
    // B. PEMANGGILAN FB PELICAN CROSSING
    // =========================================================================
    "DB_PelicanCrossing"(
        btn_Pedestrian_1     := "btn_Pedestrian_1",
        btn_Pedestrian_2     := "btn_Pedestrian_2",
        Clock_1Hz            := "Clock_1Hz",
        cfg_BuzzerCross      := ("DB_Jetson_Comm".Holding_Data[8] <> 0),
        cfg_DefaultMode      := "DB_Jetson_Comm".Holding_Data[9],
        cfg_ParadeLock       := ("DB_Jetson_Comm".Holding_Data[10] <> 0),
        cfg_StateRun         := ("DB_Jetson_Comm".Holding_Data[11] <> 0),
        cfg_ManualState      := "DB_Jetson_Comm".Holding_Data[12],
        cfg_FloodlightMode   := "DB_Jetson_Comm".Holding_Data[13],
        cfg_FloodlightOnHour := "DB_Jetson_Comm".Holding_Data[16],
        cfg_FloodlightOnMin  := "DB_Jetson_Comm".Holding_Data[17],
        cfg_FloodlightOffHour:= "DB_Jetson_Comm".Holding_Data[18],
        cfg_FloodlightOffMin := "DB_Jetson_Comm".Holding_Data[19],
        cfg_ResetViolation   := ("DB_Jetson_Comm".Holding_Data[23] <> 0),
        cfg_TimerState1      := "DB_Jetson_Comm".Holding_Data[2],
        cfg_TimerState2      := "DB_Jetson_Comm".Holding_Data[3],
        cfg_TimerState3      := "DB_Jetson_Comm".Holding_Data[4],
        cfg_TimerState4      := "DB_Jetson_Comm".Holding_Data[5],
        cfg_TimerState5      := "DB_Jetson_Comm".Holding_Data[6],
        cfg_TimerState6      := "DB_Jetson_Comm".Holding_Data[7],
        out_Traffic_Green    => "out_Traffic_Green",    // %Q0.0
        out_Traffic_Yellow   => "out_Traffic_Yellow",   // %Q0.1
        out_Traffic_Red      => "out_Traffic_Red",      // %Q0.2
        out_Ped_Green        => "out_Ped_Green",        // %Q0.3
        out_Ped_Red          => "out_Ped_Red",          // %Q0.4
        // %Q0.5 : SPARE (tidak dipetakan - display dikontrol di luar PLC)
        out_Buzzer           => "out_Buzzer",           // %Q0.6
        out_Floodlight       => "out_Floodlight",       // %Q0.7
        out_Violation_Side1  => "DB_Jetson_Comm".Holding_Data[14],
        out_Violation_Side2  => "DB_Jetson_Comm".Holding_Data[15],
        out_TimerVal         => "DB_Jetson_Comm".Holding_Data[21],
        out_Heartbeat        => "DB_Jetson_Comm".Holding_Data[22]
    );

    // Reset perintah lompat manual setelah dieksekusi (auto-clear)
    IF "DB_Jetson_Comm".Holding_Data[12] >= 0 THEN
        "DB_Jetson_Comm".Holding_Data[12] := -1;
    END_IF;

    // Reset perintah reset pelanggaran setelah dieksekusi (auto-clear)
    IF "DB_Jetson_Comm".Holding_Data[23] <> 0 THEN
        "DB_Jetson_Comm".Holding_Data[23] := 0;
    END_IF;

    // =========================================================================
    // C. DATA STATUS UNTUK DIBACA JETSON
    // =========================================================================
    "DB_Jetson_Comm".Holding_Data[0] := "DB_PelicanCrossing".iState;
    "DB_Jetson_Comm".Holding_Data[1] := "DB_PelicanCrossing".iViolation;

    // Bitmask status output fisik (Reg 20)
    "DB_PelicanSys".iOutMask := 0;
    IF "out_Traffic_Green"  THEN "DB_PelicanSys".iOutMask := "DB_PelicanSys".iOutMask + 1;   END_IF;
    IF "out_Traffic_Yellow" THEN "DB_PelicanSys".iOutMask := "DB_PelicanSys".iOutMask + 2;   END_IF;
    IF "out_Traffic_Red"    THEN "DB_PelicanSys".iOutMask := "DB_PelicanSys".iOutMask + 4;   END_IF;
    IF "out_Ped_Green"      THEN "DB_PelicanSys".iOutMask := "DB_PelicanSys".iOutMask + 8;   END_IF;
    IF "out_Ped_Red"        THEN "DB_PelicanSys".iOutMask := "DB_PelicanSys".iOutMask + 16;  END_IF;
    // %Q0.5 (bit 32) : SPARE - sengaja tidak dikontribusikan, display dikontrol di luar PLC
    IF "out_Buzzer"         THEN "DB_PelicanSys".iOutMask := "DB_PelicanSys".iOutMask + 64;  END_IF;
    IF "out_Floodlight"     THEN "DB_PelicanSys".iOutMask := "DB_PelicanSys".iOutMask + 128; END_IF;
    "DB_Jetson_Comm".Holding_Data[20] := "DB_PelicanSys".iOutMask;

    // =========================================================================
    // D. MODBUS TCP SERVER (Port 502) + WATCHDOG & AUTONOMOUS FAIL-SAFE
    // =========================================================================
    "MB_SERVER_DB_1"(
        DISCONNECT  := "DB_PelicanSys".bMbDisconnect,
        CONNECT_ID  := 1,
        IP_PORT     := 502,
        MB_HOLD_REG := "DB_Jetson_Comm".Holding_Data
    );

    #bSecPulse := "Clock_1Hz" AND (NOT "DB_PelicanSys".bSecMem);
    "DB_PelicanSys".bSecMem := "Clock_1Hz";

    IF "MB_SERVER_DB_1".NDR OR "MB_SERVER_DB_1".DR THEN
        // Ada request baca/tulis dari Jetson -> koneksi sehat
        "DB_PelicanSys".iMbIdleSec    := 0;
        "DB_PelicanSys".bMbDisconnect := FALSE;
    ELSIF "DB_PelicanSys".bMbDisconnect THEN
        // Pulsa disconnect cukup 1 scan, lalu kembali listening
        "DB_PelicanSys".bMbDisconnect := FALSE;
    ELSIF #bSecPulse THEN
        "DB_PelicanSys".iMbIdleSec := "DB_PelicanSys".iMbIdleSec + 1;

        // [WATCHDOG 1]: 10 detik tanpa request -> putus koneksi lama (anti soket gantung 16#7002)
        IF "DB_PelicanSys".iMbIdleSec = 10 THEN
            "DB_PelicanSys".bMbDisconnect := TRUE;
        END_IF;

        // [WATCHDOG 2 / AUTONOMOUS FAIL-SAFE]:
        // Jika 60 detik tanpa request (Jetson mati/kabel putus/gateway offline),
        // otomatis pulihkan PLC ke kondisi mandiri agar lampu tidak beku/macet di jalan raya!
        IF "DB_PelicanSys".iMbIdleSec >= 60 THEN
            "DB_Jetson_Comm".Holding_Data[10] := 0;  // Lepas Parade Lock jika aktif
            "DB_Jetson_Comm".Holding_Data[11] := 1;  // Lepas State Pause (Pastikan FSM Running)
            "DB_Jetson_Comm".Holding_Data[12] := -1; // Batalkan manual state
        END_IF;
    END_IF;
END_ORGANIZATION_BLOCK
